node_modules/
.shots/
.DS_Store
Thumbs.db
*.log

.claude/

# Sandscape CLI scaffolding, both regenerable and neither part of the game.
# .sandscape/ is local sync state — a sha256 and version per file, rewritten
# on every push. .agents/ is skill documentation the CLI installs; restore it
# with `sandscape skill install --here`.
.sandscape/
.agents/
# Also CLI-generated, and both say so in their own front matter: they are
# regenerated on every pull, and their advice ("run sandscape pull before
# doing anything", "any structure works") contradicts docs/ARCHITECTURE.md.
# A real CLAUDE.md for this project should be hand-written.
AGENTS.md
CLAUDE.md

# Sandscape design references, downloaded by `sandscape pull` into the repo
# root and assets/. They are project media on the platform, not game assets —
# nothing in src/ loads them and assets/manifest.json does not list them.
# Left on disk so a later push does not delete them server-side.
/mood_*.png
/assets/key_art_*.png

# Agent scratch: the sanctioned place for one-off bulk-edit scripts.
# Working files, not deliverables.
dev/tmp/

# Generated environment masters remain local; runtime WebP copies are tracked.
assets/ground/*-v2.png
assets/foliage/*.png
